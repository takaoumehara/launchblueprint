{
  "name": "blueprint-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Blueprint hub: hosted MCP server on a Cloudflare Worker (phase 1, internal bots).",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "CREATIVITY IS EVERYWHERE, LLC",
  "type": "module",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "test": "npm run catalog && node --test test/*.test.ts",
    "dev": "npm run catalog && wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply blueprint-hub --local",
    "bundle": "npm run catalog && wrangler deploy --dry-run --outdir dist-bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
