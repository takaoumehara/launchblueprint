# Real-AI suggestion on the Decide screen. Off by default; the rule-based suggestion is used instead.
# Build-time (Vite): makes the browser call /api/ai-pick
VITE_BP_AI_PICK=off
# Host runtime (serverless function api/ai-pick.js). Set these in the host's environment, never in the repo.
# BP_AI_PICK=on
# ANTHROPIC_API_KEY=            # server-side only; the browser never sees it
# BP_AI_MODEL=claude-opus-5-5   # optional override
